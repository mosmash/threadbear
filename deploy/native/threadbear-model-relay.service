[Unit]
Description=Threadbear native model-relay
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/bin/python3 %h/services/threadbear/native/runtime/deploy/native/launch.py --root %h/services/threadbear model-relay
WorkingDirectory=%h/services/threadbear
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/services/threadbear/native/logs %h/services/threadbear/relay-state
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=128M
CPUQuota=50%
TasksMax=32
LimitCORE=0
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=default.target
