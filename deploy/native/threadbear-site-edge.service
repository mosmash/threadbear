[Unit]
Description=Threadbear native site-edge
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/bin/python3 %h/services/threadbear/native/runtime/deploy/native/launch.py --root %h/services/threadbear site-edge
WorkingDirectory=%h/services/threadbear
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/services/threadbear/native/logs
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=64M
CPUQuota=25%
TasksMax=32
LimitCORE=0
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=default.target
