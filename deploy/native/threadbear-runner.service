[Unit]
Description=Threadbear native runner
After=network-online.target
Wants=threadbear-model-relay.service
After=threadbear-model-relay.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/bin/python3 %h/services/threadbear/native/runtime/deploy/native/launch.py --root %h/services/threadbear runner
WorkingDirectory=%h/services/threadbear
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/services/threadbear/native/logs %h/services/threadbear/runner %h/services/threadbear/home %h/services/threadbear/workspace
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=2G
CPUQuota=200%
TasksMax=256
LimitCORE=0
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=default.target
